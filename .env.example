# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
# Reference: plan.md §4.14

# --- Models ------------------------------------------------------------------
# Every supported gateway speaks the OpenAI wire protocol, so switching between
# them is configuration only. Set LLM_PROVIDER to pick one; each reads its own
# key variable and brings its own default model IDs (plan.md §4.14).
#
#   openrouter      — routes to many providers; openrouter/free is free of charge
#   deutschlandgpt  — GDPR-compliant German gateway brokering Claude models
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
DEUTSCHLANDGPT_API_KEY=

# Leave these unset to take the provider's defaults. Set them to override.
#
# The pipeline splits two jobs on purpose: judgement work that runs once and
# must be right (extraction, storyboard) and work that fans out and retries
# (scene codegen, repair). On DeutschlandGPT that is claude-opus-5 and
# claude-sonnet-5 respectively.
#
# `openrouter/free` collapses both into one slug, and it is a *router*: it picks
# a free model at random per call, so quality and structured-output reliability
# vary between requests. Fine for wiring up and smoke-testing the pipeline;
# pin a specific model here before judging codegen quality.
# MODEL_PLANNER=
# MODEL_CODEGEN=

# Override the provider's base URL. Rarely needed.
# LLM_BASE_URL=
LLM_TIMEOUT_MS=120000

# --- Narration ---------------------------------------------------------------
# ELEVENLABS_SPEED is not a preference, it is a measurement. `npm run calibrate`
# synthesises a known 100-word sample per voice, measures the real rate with
# ffprobe, and reports what to set here (plan.md §4.4). It lives outside
# `npm run doctor` because each measurement spends characters against the quota.
ELEVENLABS_API_KEY=
# Daniel — the slowest of the 21 voices measured, at 145.2 wpm.
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# 0.7 is the floor eleven_multilingual_v2 accepts; below it the API 400s. All 21
# voices bottom out at 145-148 wpm, which is why the sek1 band in the rulebook
# is [120, 150] rather than the original [120, 135] (plan.md §4.4).
ELEVENLABS_SPEED=0.7

# --- Rendering ---------------------------------------------------------------
# The host has no ffmpeg, no ffprobe, and a Python version Manim CE does not
# support, so everything shell-based runs in this image.
MANIM_IMAGE=tafel-manim:local
# -ql is 854x480@15 and renders 3-4x faster than 720p30. Safe because the sync
# tolerance is derived from the frame rate, not fixed in milliseconds (plan.md §4.11).
MANIM_QUALITY=-ql
RENDER_CONCURRENCY=3
RENDER_TIMEOUT_MS=180000

# --- Storage -----------------------------------------------------------------
WORKSPACE_DIR=./workspace
RULES_DIR=./guidelines

# --- Scope -------------------------------------------------------------------
# The one subject driven end to end this sprint. The parser handles all three.
DEEP_LIBRARY_SUBJECT=mathematics
